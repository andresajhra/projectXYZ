{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pharma ERP",
  "version": "0.1.0",
  "identifier": "bo.pharma.erp",
  "build": {
    "beforeDevCommand": "pnpm --filter @pharma/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @pharma/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [{ "title": "Pharma ERP", "width": 1280, "height": 800, "minWidth": 1024, "minHeight": 640 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}

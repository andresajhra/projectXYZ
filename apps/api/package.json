{
  "name": "@pharma/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@pharma/contracts": "workspace:*",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^3.0.0",
    "dotenv": "^16.4.0",
    "google-auth-library": "^9.15.0",
    "node-forge": "^1.3.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.5.0",
    "rxjs": "^7.8.1",
    "soap": "^1.1.0",
    "xml-crypto": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.11",
    "@types/pg": "^8.11.0",
    "prisma": "^7.0.0",
    "typescript": "^5.8.0"
  }
}
